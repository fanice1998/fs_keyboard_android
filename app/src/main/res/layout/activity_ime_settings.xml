<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_height_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/keyboard_height_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/keyboard_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:min="36"
            android:max="64"
            android:progress="42"
            android:contentDescription="@string/keyboard_height_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/keyboard_height_preview"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/keyboard_height_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:contentDescription="@string/keyboard_height_preview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:text="@string/keyboard_height_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/full_width_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/full_width_switch"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/full_width_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/zhuyin_computer_layout_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/zhuyin_computer_layout_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/zhuyin_computer_layout_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/zhuyin_computer_layout_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/latin_top_number_row_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/latin_top_number_row_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/latin_top_number_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/latin_top_number_row_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/latin_computer_keys_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/latin_computer_keys_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/latin_computer_keys_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:text="@string/latin_computer_keys_summary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/computer_key_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/computer_key_editor_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/computer_key_editor_hint"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/computer_key_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/computer_key_letter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/computer_key_pick_letter"
                android:textSize="16sp" />

            <GridLayout
                android:id="@+id/computer_key_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignBounds"
                android:columnCount="3" />

            <Button
                android:id="@+id/computer_key_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/computer_key_reset" />
        </LinearLayout>

        <Switch
            android:id="@+id/vibration_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vibration_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/vibration_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="@string/vibration_summary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/vibration_strength_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/vibration_strength_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/vibration_strength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:min="0"
            android:max="100"
            android:progress="60"
            android:contentDescription="@string/vibration_strength_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:text="@string/vibration_strength_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/ink_theme_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ink_theme_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ink_theme_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/ink_theme_summary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/appearance_section"
            android:textSize="18sp" />

        <Button
            android:id="@+id/appearance_background_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/appearance_background_color" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/appearance_alpha_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/appearance_alpha_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/appearance_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:min="0"
            android:max="100"
            android:progress="100"
            android:contentDescription="@string/appearance_alpha_label" />

        <TextView
            android:id="@+id/appearance_alpha_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/appearance_alpha_summary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/appearance_image_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_image_pick" />

        <Button
            android:id="@+id/appearance_image_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_image_clear"
            android:visibility="gone" />

        <Button
            android:id="@+id/appearance_key_fill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_key_fill" />

        <Switch
            android:id="@+id/appearance_key_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/appearance_key_border"
            android:textSize="18sp" />

        <Button
            android:id="@+id/appearance_key_border_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_key_border_color" />

        <Button
            android:id="@+id/appearance_key_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_key_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/appearance_animation_label"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/appearance_animation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/appearance_animation_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/appearance_animation_none" />

            <RadioButton
                android:id="@+id/appearance_animation_pop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/appearance_animation_pop" />

            <RadioButton
                android:id="@+id/appearance_animation_ripple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/appearance_animation_ripple" />

            <RadioButton
                android:id="@+id/appearance_animation_flash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/appearance_animation_flash" />

            <RadioButton
                android:id="@+id/appearance_animation_sink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/appearance_animation_sink" />
        </RadioGroup>

        <Button
            android:id="@+id/appearance_candidate_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_candidate_bar" />

        <Button
            android:id="@+id/appearance_candidate_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_candidate_selected" />

        <Button
            android:id="@+id/appearance_candidate_unselected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_candidate_unselected" />

        <Button
            android:id="@+id/appearance_candidate_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_candidate_text" />

        <TextView
            android:id="@+id/appearance_contrast_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="@string/appearance_contrast_note"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/appearance_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance_reset" />

        <TextView
            android:id="@+id/appearance_reset_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/appearance_reset_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/key_preview_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/key_preview_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/key_preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/key_preview_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/unused_habit_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/unused_habit_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/unused_habit_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/unused_habit_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/rerank_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/rerank_switch"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/rerank_summary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/rerank_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/key_latency_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/key_latency_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/key_latency_summary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/key_latency_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_latency_reset" />
    </LinearLayout>
</ScrollView>
