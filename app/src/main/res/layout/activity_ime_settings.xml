<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_height_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/keyboard_height_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/keyboard_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:min="36"
            android:max="64"
            android:progress="42"
            android:contentDescription="@string/keyboard_height_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/keyboard_height_preview"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/keyboard_height_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:contentDescription="@string/keyboard_height_preview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:text="@string/keyboard_height_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/full_width_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/full_width_switch"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/full_width_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/zhuyin_computer_layout_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/zhuyin_computer_layout_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/zhuyin_computer_layout_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/zhuyin_computer_layout_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/latin_top_number_row_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/latin_top_number_row_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/latin_top_number_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/latin_top_number_row_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/latin_computer_keys_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/latin_computer_keys_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/latin_computer_keys_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:text="@string/latin_computer_keys_summary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/computer_key_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/computer_key_editor_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/computer_key_editor_hint"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/computer_key_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/computer_key_letter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="@string/computer_key_pick_letter"
                android:textSize="16sp" />

            <GridLayout
                android:id="@+id/computer_key_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignBounds"
                android:columnCount="3" />

            <Button
                android:id="@+id/computer_key_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/computer_key_reset" />
        </LinearLayout>

        <Switch
            android:id="@+id/vibration_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vibration_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/vibration_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/vibration_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/key_preview_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/key_preview_switch"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/key_preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:text="@string/key_preview_summary"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/rerank_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/rerank_switch"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/rerank_summary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/rerank_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/key_latency_label"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/key_latency_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/key_latency_summary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/key_latency_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_latency_reset" />
    </LinearLayout>
</ScrollView>
